# ==========================================
# Personal Second Brain Environment Template
# ==========================================

# 1. LLM Core Configuration (Choose Local or Cloud)
# Set to 'openai(through xkiro gateway)' or 'ollama'
LLM_PROVIDER=openai 
XKIRO_API_KEY=your_xkiro_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# 2. Vector Database Settings
CHROMA_DB_PATH=./chroma_db
EMBEDDING_MODEL_NAME=text-embedding-3-small

# 3. MLOps Observability & Tracing (Highly Recommended)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=personal-second-brain

# 4. Backend Server Settings
PORT=8000
HOST=0.0.0.0
