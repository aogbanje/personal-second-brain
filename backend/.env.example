DATABASE_URL=postgresql+asyncpg://psb:psb@localhost:5432/psb
REDIS_URL=redis://localhost:6379/0

# Generation. Leave ANTHROPIC_BASE_URL unset to hit the Anthropic API directly;
# set it to point the SDK at a gateway/proxy instead.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
ANSWER_MODEL=claude-opus-5

# Must match the vector(N) column width in infra/init.sql.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Sessions. An opaque token in an httpOnly cookie, not a JWT, so logout can
# actually revoke. Cookie rather than a header because the SSE progress stream
# is an EventSource, which cannot set one.
SESSION_COOKIE_NAME=psb_session
SESSION_TTL_DAYS=30
# Must be true anywhere the frontend is served over HTTPS. False only works
# because local dev is http://localhost.
COOKIE_SECURE=false
