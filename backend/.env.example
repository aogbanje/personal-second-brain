DATABASE_URL=postgresql+asyncpg://psb:psb@localhost:5432/psb
REDIS_URL=redis://localhost:6379/0

# Generation. Leave ANTHROPIC_BASE_URL unset to hit the Anthropic API directly;
# set it to point the SDK at a gateway/proxy instead.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
ANSWER_MODEL=claude-opus-5

# Must match the vector(N) column width in infra/init.sql.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Auth is not built yet. Every row is written under this workspace so the
# columns are populated from day one and queries need no rewrite later.
DEFAULT_WORKSPACE_ID=00000000-0000-0000-0000-000000000001
